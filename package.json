{
  "name": "dsh-ui-colors",
  "private": false,
  "version": "0.32.0-alpha.1",
  "author": "scsmash3r",
  "description": "Surface and border colors, named presets, palette spectra, and radius presets for the DSH Web GUI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scsmash3r/dsh-ui-colors.git"
  },
  "homepage": "https://github.com/scsmash3r/dsh-ui-colors#readme",
  "bugs": {
    "url": "https://github.com/scsmash3r/dsh-ui-colors/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "deepseek",
    "theme",
    "theming",
    "ui",
    "colors",
    "shiki",
    "syntax",
    "highlight"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md",
    "docs"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node test/smoke.mjs && node test/manifest.test.mjs && node test/token-policy.test.mjs",
    "audit:tokens": "node scripts/audit-theme-tokens.mjs",
    "audit:tokens:update": "node scripts/audit-theme-tokens.mjs --write-fixture"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  }
}
